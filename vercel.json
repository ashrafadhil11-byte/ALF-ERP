{
  "regions": [
    "hnd1"
  ],
  "buildCommand": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build && rm -rf web/node_modules",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/login.html",
      "destination": "/app/login",
      "permanent": false
    },
    {
      "source": "/track.html",
      "destination": "/app/track",
      "permanent": false
    },
    {
      "source": "/admin/:page(super-dashboard|shipments|booking|status-update|delivery|consolidation|customers|crm|accounts|warehouse|attendance|create-user|branches|integrations|activity).html",
      "destination": "/app/:page",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:route",
      "destination": "/api/router?__route=:route"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/carrier-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/summary",
      "schedule": "0 16 * * *"
    }
  ]
}
